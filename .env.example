# ZULONEX 统一登录入口
PUBLIC_BUSINESS_LOGIN_URL=https://boss.zulonex.com

# 预约线索通知，可按需配置一个或两个
WECHAT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# 线索文件保存位置
LEADS_FILE=./data/leads.jsonl
LEADS_ADMIN_TOKEN=please-change-leads-admin-token

# 飞书多维表格同步预约线索
# 需要飞书自建应用凭证，以及目标多维表格 app_token / table_id。
# 推荐先把表格字段设为文本类型，字段名使用下方默认中文名。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_LEADS_FIELD_CREATED_AT=提交时间
FEISHU_LEADS_FIELD_NAME=姓名
FEISHU_LEADS_FIELD_PHONE=手机号
FEISHU_LEADS_FIELD_ORGANIZATION=机构名称
FEISHU_LEADS_FIELD_CITY=所在城市
FEISHU_LEADS_FIELD_ROLE=身份角色
FEISHU_LEADS_FIELD_COOPERATION_TYPE=合作类型
FEISHU_LEADS_FIELD_MESSAGE=需求描述
FEISHU_LEADS_FIELD_SOURCE=来源
FEISHU_LEADS_FIELD_IP=IP

# 合作模式资料访问验证
COOPERATION_ACCESS_SECRET=please-change-to-a-long-random-secret
COOPERATION_ACCESS_LOG_FILE=./data/cooperation-access.jsonl
COOPERATION_ACCESS_ADMIN_TOKEN=please-change-admin-token
