---
import "../styles/global.css";
import logoBlue from "@/assets/brand/logo-blue.svg";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  noindex = false
} = Astro.props;

const canonical = new URL(path, Astro.site ?? "https://zulonex.com").toString();
const socialImage = new URL("/og-zulonex.png", Astro.site ?? "https://zulonex.com").toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: "https://zulonex.com",
  logo: new URL(logoBlue.src, Astro.site ?? "https://zulonex.com").toString(),
  description: site.description,
  email: site.email,
  slogan: site.tagline,
  brand: [
    {
      "@type": "Brand",
      name: "星鹿爱学"
    }
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: site.email,
    contactType: "business inquiries",
    availableLanguage: ["Chinese"]
  }
};
---

<!doctype html>
<html lang="zh-CN" data-theme="v2">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="逐鹿未来：让 AI 学习服务在真实场景中落地" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f6f9ff" />
    <script is:inline>
      (() => {
        const allowed = new Set(["v2", "classic", "dark"]);
        const saved = window.localStorage.getItem("zulonex-theme");
        document.documentElement.dataset.theme = saved && allowed.has(saved) ? saved : "v2";
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" class="pt-[72px]" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const themeWindow = window as Window & {
        ZulonexTheme?: {
          get: () => string;
          apply: (theme?: string) => string;
        };
      };

      themeWindow.ZulonexTheme = {
        get: () => document.documentElement.dataset.theme || "v2",
        apply: (theme = "v2") => {
          const next = ["v2", "classic", "dark"].includes(theme) ? theme : "v2";
          document.documentElement.dataset.theme = next;
          window.localStorage.setItem("zulonex-theme", next);
          return next;
        }
      };

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        document.documentElement.classList.add("motion-ready");

        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );

        document.querySelectorAll("[data-reveal]").forEach((element) => revealObserver.observe(element));

        const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
        if (parallaxItems.length && window.matchMedia("(min-width: 768px)").matches) {
          let parallaxFrame = 0;

          const updateParallax = () => {
            parallaxItems.forEach((element) => {
              const rect = element.getBoundingClientRect();
              if (rect.bottom < -120 || rect.top > window.innerHeight + 120) return;

              const speed = Number(element.dataset.parallax || 0.06);
              const max = Number(element.dataset.parallaxMax || 44);
              const distance = rect.top + rect.height / 2 - window.innerHeight / 2;
              const offset = Math.max(-max, Math.min(max, distance * -speed));
              element.style.setProperty("--parallax-y", `${offset.toFixed(2)}px`);
            });
            parallaxFrame = 0;
          };

          const scheduleParallax = () => {
            if (parallaxFrame) return;
            parallaxFrame = window.requestAnimationFrame(updateParallax);
          };

          updateParallax();
          window.addEventListener("scroll", scheduleParallax, { passive: true });
          window.addEventListener("resize", scheduleParallax);
        }
      } else {
        document.querySelectorAll("[data-reveal]").forEach((element) => element.classList.add("is-visible"));
        document.querySelectorAll<HTMLVideoElement>("[data-hero-video]").forEach((video) => {
          video.pause();
          video.removeAttribute("autoplay");
        });
      }
    </script>
  </body>
</html>
