---
import Icon from "@/components/Icon.astro";
import brandBg from "@/assets/brand/brand-bg-blue.webp";

interface Props {
  title?: string;
  description?: string;
  href?: string;
  label?: string;
  iconName?: string;
}

const {
  title = "让星鹿爱学进入你的运营场景",
  description = "预约演示，了解产品与落地支持。",
  href = "/contact/",
  label = "预约产品演示",
  iconName = "CalendarCheck"
} = Astro.props;
---

<section
  class="page-band bg-sea py-16 text-white md:py-20"
  data-nav-theme="dark"
  style={`background-image: linear-gradient(105deg, rgba(6,18,74,.92), rgba(31,97,255,.78)), url(${brandBg.src}); background-size: cover; background-position: center;`}
>
  <div class="container-page grid gap-8 md:grid-cols-[1fr_auto] md:items-end" data-reveal="soft">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-white/56">Next Step</p>
      <h2 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">{title}</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/72">
        {description}
      </p>
    </div>
    <a
      href={href}
      class="motion-link inline-flex w-fit items-center gap-2 bg-white px-6 py-3.5 text-base font-semibold text-sea transition hover:bg-mist"
    >
      <Icon name={iconName} size={18} />
      {label}
      <Icon name="ArrowRight" size={18} />
    </a>
  </div>
</section>
