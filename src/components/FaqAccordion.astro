---
import Icon from "@/components/Icon.astro";
import type { FaqItem } from "@/data/faqs";

interface Props {
  items: FaqItem[];
  groupName: string;
  openFirst?: boolean;
}

const { items, groupName, openFirst = false } = Astro.props;
---

<div class="border-t border-ink/12">
  {items.map((item, index) => (
    <details
      id={item.id}
      name={groupName}
      class="faq-details group scroll-mt-32 border-b border-ink/12"
      open={openFirst && index === 0}
      data-reveal="soft"
    >
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-ink">
        <h3 class="text-lg font-semibold leading-7 sm:text-xl">{item.question}</h3>
        <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center border border-ink/12 text-sea transition group-hover:border-sea/40 group-open:bg-sea group-open:text-white">
          <Icon name="Plus" class="transition group-open:rotate-45" size={20} />
        </span>
      </summary>
      <div class="max-w-3xl pb-7 pr-10 text-base leading-8 text-muted">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-details summary::-webkit-details-marker {
    display: none;
  }
</style>
