---
import logoBlue from "@/assets/brand/logo-blue.svg";
import logoLight from "@/assets/brand/logo-light.svg";
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header data-theme="light" data-scrolled="false" data-business-login-url={site.businessLoginUrl}>
  <div class="container-page flex h-[72px] items-center justify-between gap-5">
    <a href="/" class="brand-link" aria-label="逐鹿未来首页">
      <img
        src={logoBlue.src}
        width="1203"
        height="183"
        alt="逐鹿未来"
        class="brand-mark brand-mark-blue"
      />
      <img
        src={logoLight.src}
        width="1203"
        height="183"
        alt=""
        class="brand-mark brand-mark-light"
      />
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="主导航">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
          class:list={[
            "nav-link px-3 py-2 text-sm font-medium",
            currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "is-active" : ""
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 xl:flex">
      <a href={site.businessLoginUrl} class="nav-login inline-flex items-center gap-2 px-3 py-2.5 text-sm font-semibold" data-business-login>
        <Icon name="LogIn" size={16} />
        商家登录
      </a>
      <a
        href="/contact/"
        class="nav-cta inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold"
      >
        <Icon name="PhoneCall" size={16} />
        预约演示
      </a>
    </div>

    <button
      class="menu-button focus-ring grid h-10 w-10 place-items-center border xl:hidden"
      type="button"
      aria-label="打开导航"
      aria-expanded="false"
      data-menu-button
    >
      <span data-menu-open><Icon name="Menu" size={22} /></span>
      <span class="hidden" data-menu-close><Icon name="X" size={22} /></span>
    </button>
  </div>

  <nav class="mobile-nav hidden max-h-[calc(100vh-72px)] overflow-y-auto border-t xl:hidden" aria-label="移动导航" data-mobile-menu>
    <div class="container-page grid gap-1 py-4">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
          class:list={[
            "mobile-nav-link px-4 py-3 text-sm font-medium",
            currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "is-active" : ""
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-3 grid grid-cols-2 gap-2 border-t pt-4" style="border-color: var(--header-border)">
        <a href={site.businessLoginUrl} class="mobile-action mobile-action-secondary inline-flex items-center justify-center gap-2 px-3 py-3 text-sm font-semibold" data-business-login>
          <Icon name="LogIn" size={17} />
          商家登录
        </a>
        <a href="/contact/" class="mobile-action mobile-action-primary inline-flex items-center justify-center gap-2 px-3 py-3 text-sm font-semibold">
          <Icon name="CalendarCheck" size={17} />
          预约演示
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const businessLoginUrl = header instanceof HTMLElement ? header.dataset.businessLoginUrl || "" : "";
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-open]");
  const closeIcon = document.querySelector("[data-menu-close]");
  const businessLoginLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-business-login]")).filter(
    (link) => link instanceof HTMLAnchorElement
  );

  const updateBusinessLoginLinks = () => {
    if (!businessLoginLinks.length) return;

    try {
      const target = new URL(businessLoginUrl, window.location.origin);
      const mobile = window.matchMedia("(max-width: 767px)").matches;
      target.searchParams.set("source", "zulonex.com");
      target.searchParams.set("terminal", mobile ? "mobile" : "desktop");
      target.searchParams.set("target", "auto");
      businessLoginLinks.forEach((link) => {
        link.href = target.toString();
      });
    } catch {
      businessLoginLinks.forEach((link) => {
        link.href = businessLoginUrl;
      });
    }
  };

  const updateHeaderTheme = () => {
    if (!header) return;

    const sampleX = Math.min(window.innerWidth / 2, window.innerWidth - 24);
    const sampleY = Math.min(36, window.innerHeight - 1);
    const backgroundElement = document
      .elementsFromPoint(sampleX, sampleY)
      .find((element) => !header.contains(element));
    const themedSection = backgroundElement?.closest("[data-nav-theme]");
    const theme = themedSection instanceof HTMLElement && themedSection.dataset.navTheme === "dark" ? "dark" : "light";

    header.dataset.theme = theme;
    header.dataset.scrolled = String(window.scrollY > 12);
  };

  let headerFrame = 0;
  const scheduleHeaderUpdate = () => {
    if (headerFrame) return;
    headerFrame = window.requestAnimationFrame(() => {
      updateHeaderTheme();
      headerFrame = 0;
    });
  };

  updateBusinessLoginLinks();
  updateHeaderTheme();
  window.addEventListener("scroll", scheduleHeaderUpdate, { passive: true });
  window.addEventListener("resize", () => {
    updateBusinessLoginLinks();
    scheduleHeaderUpdate();
  });

  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    button.setAttribute("aria-label", expanded ? "打开导航" : "关闭导航");
    menu?.classList.toggle("hidden", expanded);
    openIcon?.classList.toggle("hidden", !expanded);
    closeIcon?.classList.toggle("hidden", expanded);
    header?.toggleAttribute("data-menu-open", !expanded);
  });
</script>

<style>
  .site-header {
    --header-text: #52646c;
    --header-strong: #06124a;
    --header-border: rgba(6, 18, 74, 0.1);
    --header-panel: rgba(255, 255, 255, 0.94);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid var(--header-border);
    background: var(--header-panel);
    color: var(--header-text);
    backdrop-filter: blur(18px) saturate(135%);
    transition:
      background-color 320ms ease,
      border-color 320ms ease,
      color 320ms ease,
      box-shadow 320ms ease;
  }

  .site-header[data-theme="dark"] {
    --header-text: rgba(255, 255, 255, 0.76);
    --header-strong: #ffffff;
    --header-border: rgba(255, 255, 255, 0.14);
    --header-panel: rgba(6, 18, 74, 0.08);
    backdrop-filter: blur(8px) saturate(115%);
  }

  .site-header[data-theme="dark"][data-scrolled="true"],
  .site-header[data-theme="dark"][data-menu-open] {
    --header-panel: rgba(6, 18, 74, 0.78);
    backdrop-filter: blur(18px) saturate(125%);
    box-shadow: 0 12px 40px rgba(3, 10, 42, 0.14);
  }

  .site-header[data-theme="light"][data-scrolled="true"],
  .site-header[data-theme="light"][data-menu-open] {
    box-shadow: 0 12px 40px rgba(6, 18, 74, 0.08);
  }

  .brand-link {
    position: relative;
    display: block;
    width: 188px;
    height: 29px;
    flex: 0 0 auto;
  }

  .brand-mark {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    transition: opacity 240ms ease;
  }

  .brand-mark-light,
  .site-header[data-theme="dark"] .brand-mark-blue {
    opacity: 0;
  }

  .site-header[data-theme="dark"] .brand-mark-light {
    opacity: 1;
  }

  .nav-link {
    position: relative;
    color: var(--header-text);
    transition: color 180ms ease;
  }

  .nav-link::after {
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--header-strong);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-cta {
    background: #06124a;
    color: #ffffff;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .nav-login {
    color: var(--header-strong);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .nav-login:hover {
    background: rgba(31, 97, 255, 0.09);
    color: #1f61ff;
  }

  .site-header[data-theme="dark"] .nav-login:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .nav-cta:hover {
    background: #1f61ff;
    transform: translateY(-1px);
  }

  .site-header[data-theme="dark"] .nav-cta {
    background: #ffffff;
    color: #1f61ff;
  }

  .site-header[data-theme="dark"] .nav-cta:hover {
    background: #edf4ff;
  }

  .menu-button {
    border-color: var(--header-border);
    color: var(--header-strong);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .menu-button:hover {
    background: rgba(31, 97, 255, 0.08);
  }

  .mobile-nav {
    border-color: var(--header-border);
    background: var(--header-panel);
  }

  .mobile-nav-link {
    color: var(--header-text);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    background: rgba(31, 97, 255, 0.1);
    color: var(--header-strong);
  }

  .mobile-action {
    border: 1px solid var(--header-border);
  }

  .mobile-action-secondary {
    color: var(--header-strong);
  }

  .mobile-action-primary {
    border-color: transparent;
    background: #06124a;
    color: #ffffff;
  }

  .site-header[data-theme="dark"] .mobile-action-primary {
    background: #ffffff;
    color: #1f61ff;
  }

  @media (max-width: 640px) {
    .brand-link {
      width: 164px;
      height: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand-mark,
    .nav-link,
    .nav-link::after,
    .nav-login,
    .nav-cta {
      transition: none;
    }
  }
</style>
