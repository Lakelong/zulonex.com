---
import BaseLayout from "@/components/BaseLayout.astro";
---

<BaseLayout title="页面未找到 | 逐鹿未来" description="页面未找到" noindex={true}>
  <section class="bg-mist py-24">
    <div class="container-page max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sea">404</p>
      <h1 class="mt-4 text-4xl font-semibold text-ink">页面没有找到</h1>
      <p class="mt-4 text-muted">你访问的页面可能已经移动，或暂时还没有上线。</p>
      <a class="mt-8 inline-flex bg-sea px-6 py-3.5 text-base font-semibold text-white" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>
