            <p class="mt-4 text-base leading-7 text-muted">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-band bg-mist py-20 md:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="Four Tutor Service Model"
        title="四师服务模型"
        description="AI智教、学业规划师、学情督导师和专属导学师分工协同，把系统能力转化为线下服务。"
      />
      <div class="mt-14 grid border-y border-ink/12 lg:grid-cols-4">
        {fourTutors.map((item, index) => (
          <article class:list={["interactive-card py-9 lg:px-7", index > 0 && "border-t border-ink/12 lg:border-l lg:border-t-0", index === 0 && "lg:pl-0"]} data-reveal="soft">
