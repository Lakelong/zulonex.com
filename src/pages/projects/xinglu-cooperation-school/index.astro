  ["营销招生", "年度营销计划", "年度目标制定及拆解"],
  ["活动输出", "阶段性活动输出", "服务+营销活动等"],
  ["运营指导", "日常运营工作指导", "一对一流程"],
  ["落地支持", "到店支持工作", "家长会、运营赋能、周年庆活动等"],
  ["人才计划", "根据体验馆/区域发展规划设定人才培养计划", ""],
  ["旗舰校观摩", "沉浸式参观、体验学习", ""]
