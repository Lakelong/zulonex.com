const schoolFeedback = [
  "清北班对比，考试成绩除少数尖子生外，各项指标远超对方，部分科目从低10分到每门课高于对方。",
  "首先解决学生的兴趣问题，引进产品后学生变得更自律，也重新有了学习兴趣。",
  "高一平均分499.5超过特快班，成为年级第1名；高二48人中35人本科线进线；高三48人中29人进步明显。"
];

const zeroTerms = ["0 加盟费", "0 库存", "0 售后"];
const youProvide = ["导学场地", "销售人员", "合作校项目履约保证金4.98万"];
const weProvide = ["星鹿爱学项目", "三套演示样机", "配备专职导学师", "运营系统支持", "引流100个客资到店"];
const profitModels = ["总部赠送客资转化", "双方共同招生转化", "总部正价客户交付", "自有生源拓科增收"];
const fitInstitutions = ["书房/阅读馆", "传统教培转型", "素质类机构", "托管/自习室"];
---

<BaseLayout
  title={`星鹿爱学联营合作校项目说明 | ${site.name}`}
  description="星鹿爱学联营合作校项目说明，按品牌背景、市场机遇、产品模式、专业赋能、案例分享与合作条件展示。"
  path="/projects/xinglu-cooperation-school/"
>
  <section class="relative -mt-[72px] overflow-hidden bg-ink text-white" data-nav-theme="dark">
    <img
      src={heroComposedBg.src}
      width={heroComposedBg.width}
      height={heroComposedBg.height}
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover object-center md:block"
      loading="eager"
      data-parallax="0.025"
      data-parallax-max="18"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(6,18,74,1)_0%,rgba(6,18,74,.98)_46%,rgba(6,18,74,.70)_72%,rgba(6,18,74,.18)_100%)]"></div>
    <div class="absolute inset-y-0 right-0 hidden w-[48%] bg-[linear-gradient(180deg,rgba(6,18,74,.10)_0%,rgba(6,18,74,0)_42%,rgba(6,18,74,.18)_100%)] md:block"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-white/16"></div>
    <div class="container-page relative flex min-h-[720px] items-center pb-16 pt-[136px]">
      <div class="max-w-3xl" data-reveal="soft">
        <p class="text-base font-semibold text-white/62">星鹿爱学 · 联营合作校项目说明</p>
        <h1 class="mt-6 text-balance text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-7xl">
          与您携手 共创AI教育服务新场景
        </h1>
        <p class="mt-7 max-w-2xl text-xl leading-9 text-white/76">
          赋能陪跑共创可持续价值，围绕三端导学AI成长系统，帮助合作校把AI学习、真人导学和本地运营落到真实服务。
        </p>
        <div class="mt-10 grid border-y border-white/16 sm:grid-cols-3">
          <div class="py-5 sm:pr-6">
            <p class="text-sm font-semibold text-white/48">项目定位</p>
            <p class="mt-2 text-2xl font-semibold">联营合作校</p>
          </div>
          <div class="border-t border-white/16 py-5 sm:border-l sm:border-t-0 sm:px-6">
            <p class="text-sm font-semibold text-white/48">核心系统</p>
            <p class="mt-2 text-2xl font-semibold">三端导学</p>
          </div>
          <div class="border-t border-white/16 py-5 sm:border-l sm:border-t-0 sm:pl-6">
            <p class="text-sm font-semibold text-white/48">服务模型</p>
            <p class="mt-2 text-2xl font-semibold">四师一体</p>
          </div>
        </div>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="motion-link inline-flex items-center justify-center gap-2 bg-white px-6 py-3.5 text-base font-semibold text-sea transition hover:bg-mist" href="#terms">
            查看合作条件
            <Icon name="ArrowRight" size={19} />
          </a>
          <a class="inline-flex items-center justify-center gap-2 border border-white/32 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-white/12" href="/contact/">
            预约项目沟通
          </a>
        </div>
      </div>
    </div>
  </section>

  <nav class="no-scrollbar sticky top-[72px] z-40 overflow-x-auto border-y border-ink/10 bg-white/95 backdrop-blur-xl" aria-label="合作校项目章节导航">
    <div class="container-page flex min-w-max items-center gap-8 py-4 text-sm font-semibold text-muted">
      {chapters.map((item) => (
        <a class="inline-flex items-center gap-2 transition hover:text-sea" href={`#${item.id}`}>
          <span class="text-sea">{item.number}</span>
          {item.title}
        </a>
      ))}
      <a class="inline-flex items-center gap-2 text-sea" href="/contact/">
        预约沟通
        <Icon name="ArrowUpRight" size={15} />
      </a>
    </div>
  </nav>

  <section id="background" class="page-band scroll-mt-32 bg-white py-20 md:py-28">
