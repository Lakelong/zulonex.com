      <div data-reveal="soft">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sea">Background</p>
        <h2 class="mt-5 text-balance text-4xl font-semibold leading-tight text-ink md:text-6xl">
          银河智学品牌背景
        </h2>
        <p class="mt-6 text-lg leading-8 text-muted">
          银河智学由原字节跳动大力教育CEO陈林和原科大讯飞教育事业群副总裁王卓领衔创立，是一家面向AI时代的教育科技公司，定位是培养AI时代的问题解决者。
        </p>
      </div>
      <div class="grid border-y border-ink/12 sm:grid-cols-2 lg:grid-cols-5">
        {brandPillars.map((item, index) => (
          <article class:list={["interactive-card py-7 sm:px-5", index > 0 && "border-t border-ink/12 sm:border-l sm:border-t-0", index === 2 && "sm:border-l-0 lg:border-l", index === 0 && "sm:pl-0"]} data-reveal="soft">
            <p class="text-sm font-semibold text-sea">0{index + 1}</p>
            <h3 class="mt-5 text-xl font-semibold leading-7 text-ink">{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-band bg-mist py-20 md:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="Market Opportunity"
        title="市场机遇 AI时代黄金赛道"
        description="AI教育全面融入教育体系核心环节，线下合作校可以承接新的学习服务需求。"
      />
      <div class="mt-14 grid border-y border-ink/12 sm:grid-cols-3">
        {marketStats.map((item, index) => (
          <article class:list={["py-8 sm:px-8", index > 0 && "border-t border-ink/12 sm:border-l sm:border-t-0", index === 0 && "sm:pl-0"]} data-reveal="soft">
            <p class="text-5xl font-semibold text-sea md:text-6xl">{item.value}</p>
            <p class="mt-4 text-base font-semibold text-ink">{item.label}</p>
          </article>
        ))}
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div data-reveal="soft">
          <h3 class="text-balance text-3xl font-semibold leading-tight text-ink md:text-4xl">
            AI教育全面融入教育体系核心环节
          </h3>
          <p class="mt-5 text-lg leading-8 text-muted">
            2030年市场规模预计突破5000亿元，年复合增长率长期维持在25%以上，成为教育产业第一大增长极。
          </p>
        </div>
        <div class="grid border-y border-ink/12 md:grid-cols-2">
          {marketPeriods.map((item, index) => (
            <article class:list={["py-8 md:px-8", index > 0 && "border-t border-ink/12 md:border-l md:border-t-0", index === 0 && "md:pl-0"]} data-reveal="soft">
              <p class="text-base font-semibold text-muted">{item.period} {item.label}</p>
              <p class="mt-4 text-5xl font-semibold text-ink">{item.value}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-band bg-white py-20 md:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[0.75fr_1.25fr]">
      <div data-reveal="soft">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sea">Policy Background</p>
        <h2 class="mt-5 text-balance text-4xl font-semibold leading-tight text-ink md:text-5xl">
          国家十五五教育数字化战略
        </h2>
        <p class="mt-6 text-lg leading-8 text-muted">智能赋能与融合创新，让AI教育从工具应用进入教学服务全过程。</p>
      </div>
      <div class="border-t border-ink/12">
        {policyItems.map((item) => (
          <article class="interactive-card grid gap-5 border-b border-ink/12 py-8 md:grid-cols-[72px_0.55fr_1fr] md:items-start" data-reveal="soft">
            <p class="text-sm font-semibold text-sea">{item.number}</p>
            <h3 class="text-2xl font-semibold text-ink">{item.title}</h3>
            <p class="text-base leading-7 text-muted">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="product-model" class="page-band scroll-mt-32 bg-ink py-20 text-white md:py-28" data-nav-theme="dark">
    <div class="container-page">
      <SectionHeader
        eyebrow="Product Model"
        title="三端导学AI成长系统"
        description="学生端、导学端、家长端共同构成持续自主学习成长的场景体系服务，重塑孩子自主学习力。"
        tone="dark"
      />
      <div class="mt-14 grid border-y border-white/16 lg:grid-cols-3">
        {terminals.map((item, index) => (
          <article class:list={["interactive-card bg-white/[0.03] py-9 lg:px-8", index > 0 && "border-t border-white/16 lg:border-l lg:border-t-0", index === 0 && "lg:pl-0"]} data-reveal="soft">
            <p class="text-7xl font-semibold leading-none text-white/16">{item.number}</p>
            <h3 class="mt-4 text-3xl font-semibold text-white">{item.title}</h3>
            <p class="mt-4 text-xl font-semibold text-white/86">{item.headline}</p>
            <p class="mt-4 text-base leading-7 text-white/64">{item.text}</p>
            <p class="mt-6 border-t border-white/14 pt-4 text-sm font-semibold leading-6 text-white/52">承载工具：{item.tool}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-band bg-white py-20 md:py-28">
    <div class="container-page grid gap-14 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
      <div data-reveal="soft">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sea">Resource System</p>
        <h2 class="mt-5 text-balance text-4xl font-semibold leading-tight text-ink md:text-5xl">
          打造原子化资源体系
        </h2>
        <p class="mt-6 text-lg leading-8 text-muted">优质、丰富、精准的资源体系，为学生端AI学习和导学端服务提供基础。</p>
        <img
          src={mascotTrophy.src}
          width={mascotTrophy.width}
          height={mascotTrophy.height}
          alt="星鹿爱学吉祥物"
          class="mt-8 w-64 max-w-full"
          loading="lazy"
        />
      </div>
      <div class="grid border-l border-t border-ink/12 sm:grid-cols-2">
        {resourceBlocks.map((item) => (
          <article class="border-b border-r border-ink/12 bg-mist p-7" data-reveal="soft">
            <Icon name="CheckCircle2" class="text-sea" size={28} />
