const caseSummaries = [
  {
    title: "阜南亲情高中",
    subtitle: "学校7年规模化落地应用",
    metric: "27.8% → 74.3%",
    text: "一本达线率提升267%，先后培养出2位清华和3位县理科状元。"
  },
  {
    title: "成都戴氏教育集团的选择",
    subtitle: "成都深耕教培30年+",
    metric: "100家校区",
    text: "累计培养清北在校生1000人+，年均稳定输送40-50名清北学生，近五年合计清北人数300人+。"
  },
  {
    title: "琪琪同学",
    subtitle: "中等生的逆袭之路",
    metric: "97 / 129 / 147",
